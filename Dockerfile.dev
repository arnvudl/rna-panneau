# Dev-only image: runs the Next.js dev server with hot reload inside Docker.
# Not intended for production use (no production Dockerfile exists yet - out of scope).
FROM node:22-alpine

WORKDIR /app

# Install dependencies first so this layer is cached unless package*.json changes.
COPY package.json package-lock.json ./
RUN npm ci

# Source is bind-mounted over this in docker-compose.yml for live editing;
# this COPY just keeps the image runnable standalone (e.g. `docker build` + `docker run`).
COPY . .

# Generate the Prisma client into node_modules/.prisma now, while node_modules still
# lives in this image layer. docker-compose.yml then persists node_modules (including
# this generated client) into a named volume so the source bind mount doesn't hide it.
# `prisma generate` doesn't connect to a database, but prisma.config.ts requires
# DATABASE_URL to be set just to load - a placeholder is enough; the real value is
# supplied at runtime via docker-compose.yml.
RUN DATABASE_URL="postgresql://placeholder:placeholder@placeholder:5432/placeholder" npx prisma generate

EXPOSE 3000

CMD ["npm", "run", "dev"]
